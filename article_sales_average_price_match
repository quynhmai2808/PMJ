# Check if one barcode maps to multiple distinct Bezeichnung (names)
check_barcode_duplication <- function(df, barcode_col = "Barcode", name_col = "Bezeichnung") {
  dup_df <- df %>%
    group_by(!!sym(barcode_col)) %>%
    summarise(
      n_names = n_distinct(!!sym(name_col)),
      names = paste(unique(!!sym(name_col)), collapse = "; "),
      .groups = "drop"
    ) %>%
    filter(n_names > 1)
  
  if (nrow(dup_df) > 0) {
    warning("Warning: Some barcodes have multiple different Bezeichnung (names):")
    print(dup_df)
  } else {
    message("No barcode duplications with different Bezeichnung found.")
  }
}

# Check transaction quantity for negatives or fractional values
check_transaction_quantity <- function(df, qty_col = "POS_POS_Quantity") {
  negative_qty <- df %>% filter(!!sym(qty_col) < 0)
  fractional_qty <- df %>% filter((!!sym(qty_col) %% 1) != 0)
  
  if (nrow(negative_qty) > 0) {
    warning(paste("Warning:", nrow(negative_qty), "rows have negative quantities in", qty_col))
    print(negative_qty)
  } else {
    message("No negative quantities found.")
  }
  
  if (nrow(fractional_qty) > 0) {
    warning(paste("Warning:", nrow(fractional_qty), "rows have fractional (non-integer) quantities in", qty_col))
    print(fractional_qty)
  } else {
    message("No fractional quantities found.")
  }
}
