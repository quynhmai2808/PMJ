# 5. Check if one barcode maps to multiple distinct Bezeichnung (names)
check_barcode_duplication <- function(df, barcode_col = "Barcode", name_col = "Bezeichnung") {
  dup_df <- df %>%
    group_by(!!sym(barcode_col)) %>%
    summarise(
      n_names = n_distinct(!!sym(name_col)),
      names = paste(unique(!!sym(name_col)), collapse = "; "),
      .groups = "drop") %>%
    filter(n_names > 1)
  
  if (nrow(dup_df) > 0) {
    warning("Warning: Some barcodes have multiple different Bezeichnung (names):")
    print(dup_df)
  } else {
    message("No barcode duplications with different Bezeichnung found.")
  }
}

# 6. Check transaction quantity for negatives or fractional values
check_transaction_quantity <- function(df, qty_col = "POS_POS_Quantity") {
  negative_qty <- df %>% filter(!!sym(qty_col) < 0)
  fractional_qty <- df %>% filter((!!sym(qty_col) %% 1) != 0)
  
  if (nrow(negative_qty) > 0) {
    warning(paste("Warning:", nrow(negative_qty), "rows have negative quantities in", qty_col))
    print(negative_qty)
  } else {
    message("No negative quantities found.")
  }
  
  if (nrow(fractional_qty) > 0) {
    warning(paste("Warning:", nrow(fractional_qty), "rows have fractional (non-integer) quantities in", qty_col))
    print(fractional_qty)
  } else {
    message("No fractional quantities found.")
  }
}

# 7. Convert to UTF-8

convert_csv_to_utf8 <- function(input_path, output_path = NULL, fallback_encoding = "latin1") {
  if (is.null(output_path)) {
    output_path <- input_path  # overwrite original file
  }
  
  # Read the raw lines
  lines <- readLines (input_path, warn = FALSE)
  
  # Collapse to a single string for encoding detection
  text_sample <- paste(lines, collapse = "\n")
  
  # Detect encoding from stringi or fallback
  is_utf8 <- stri_enc_isutf8(text_sample)
  
  if (is_utf8) {
    message("File already in UTF-8: ", input_path)
  }
  
  # Re-read using fallback encoding
  text_lines <- readLines(input_path, encoding = fallback_encoding, warn = FALSE)
  
  # Write in UTF-8
  writeLines(text_lines, output_path, useBytes = FALSE)
  
  message("File converted and saved as UTF-8: ", output_path)
}

