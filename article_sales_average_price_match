# function 1: Check if Barcode is numeric, if not print warning and remove those rows
check_and_clean_numeric <- function(df, col_name) {
  # Check non-numeric rows
  non_numeric <- df %>%
    filter(!str_detect(!!sym(col_name), "^\\d+$"))
  
  if (nrow(non_numeric) > 0) {
    warning(paste("Warning:", nrow(non_numeric), "rows have non-numeric values in column", col_name, 
                  "- These rows will be removed."))
    print(non_numeric[[col_name]])
    
    # Remove non-numeric rows
    df <- df %>%
      filter(str_detect(!!sym(col_name), "^\\d+$"))
  }
  
  return(df)
}

# function 2: Remove leading zeros from Barcode
remove_leading_zeros <- function(barcode_vec) {
  # Convert to numeric and back to character to remove leading zeros safely
  cleaned <- as.character(as.numeric(barcode_vec))
  # Handle NAs if any barcode was not numeric (should be removed by previous step)
  cleaned[is.na(cleaned)] <- barcode_vec[is.na(cleaned)]
  return(cleaned)
}

# function 3: Convert year, month name, day columns to Date object
convert_to_date <- function(year_col, month_col, day_col) {
  # Combine into a string: "day month year" e.g. "15 April 2025"
  date_str <- paste(day_col, month_col, year_col)
  # Parse date, format like "15 April 2025"
  date_obj <- dmy(date_str)
  return(date_obj)
}

# === Helper function 4: Convert Date object to week number of year
date_to_weeknum <- function(date_obj) {
  # Using ISOweek numbering (Monday = first day of week)
  week_num <- isoweek(date_obj)
  return(week_num)
}


