# 1. Check and clean if article number is numeric

check_and_clean_non_numeric <- function (df, col_name) {
  # Check non-numeric rows
  non_numeric <- df %>% 
    filter(!str_detect(!!sym(col_name), "^\\d+$"))
  
  if (nrow(non_numeric) > 0) {
    warning(paste("Warning:", nrow(non_numeric), "rows have non-numeric values in column", col_name,
                  "These non-numeric sign will be removed"))
    print(non_numeric[[col_name]])
    
    # Remove all non-digit characters (keep only 0-9)
    # df[[col_name]] <- str_replace_all(df[[col_name]], "[^0-9]", "")
  }
  
  return(df)
}

# 2. Remove leading zeros from Barcode

remove_leading_zeros <- function(barcode) {
  # Convert to numeric and back to character to remove leading zeros safely
  cleaned <- as.character(as.numeric(barcode))
  # Handle NAs if any barcode was not numeric (should be removed by previous step)
  cleaned[is.na(cleaned)] <- barcode[is.na(cleaned)]
  return(cleaned)
}

