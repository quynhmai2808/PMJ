# =========================
# HELP FUNCTION 
# =========================
nosigns <- function(variable) {
  variable <- gsub("[^0-9]", "", variable)  # Entfernt alle nicht-numerischen Zeichen
  return(variable)
}

remove_leading_zeros <- function(x) {
  return(sub("^0+", "", as.character(x))) # Entfernt alle führenden Nullen
}

normalize_key <- function(x) {
  
  x_chr <- as.character(x)
  
  x_trim <- trimws(x_chr)
  
  x_clean <- gsub("^[^[:alnum:]]+|[^[:alnum:]]+$", "", x_trim)
  
  toupper(x_clean)
}

