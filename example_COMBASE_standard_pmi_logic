# ---------- QC Rule to check MIX-PRICE --------

df_final <- df_final %>%
  mutate(PRICE = as.numeric(PRICE),
    check_price = ifelse(abs(as.numeric(PRICE) - calculate_price) < 0.01, "y", "n")) %>%
  
  # expected type from business rule
  mutate(expected_type = case_when(
    calculate_price >= 3  & calculate_price <= 25  ~ "P",
    calculate_price >= 46 & calculate_price <= 100 ~ "B",
    TRUE ~ "UNKNOWN"
    ),
    
    # strict mismatch 
    type_mismatch_flag = expected_type != EANTYPE & expected_type != "UNKNOWN",
    
    # mismatch Type with Threshold price = 30
    price_type_flag = case_when(
      EANTYPE == "P" & calculate_price > 30 ~ "P_as_Bundle",
      EANTYPE == "B" & calculate_price < 30 ~ "B_as_Pack",
      TRUE ~ "OK"
    )
  ) %>%
  select (file_date,Date,Month,Retailer,EAN,Bezeichnung,Warengruppecode,Warengruppe,
          EANTYPE,expected_type,PRODUCTNUMBER,Sales,Revenue,calculate_price,PRICE,check_price,type_mismatch_flag, price_type_flag,PACKSPERBUNDLE,ITEMSPERPACK,everything())

