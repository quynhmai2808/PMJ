# Analyse Statistic: EAN_count, Store_count, number of records, Total Sales, Total Revenue

# mix_price_cases_list <- vector("list", length(data_list)) # initialize a list for saving result before running loop

summary_df <- lapply(seq_len(length(data_list)), function(i) {
  
  df <- data_list[[i]]
  
  # ---- Standardize data ------
  
  EAN <- as.character(df$POS_Barcode_No)
  Text <- df$Bezeichnung
  
  Sales   <- as.numeric(gsub(",", ".", df$POS_POS_Quantity))
  Revenue <- as.numeric(gsub(",", ".", df$POS_Amount_Tendered))
  
  calculate_price <- ifelse(
    Sales > 0,
    round(Revenue / Sales, 2),
    NA
  )
  
  df$calculate_price <- calculate_price
  
  # --- Checks ---
  
  # 1. Duplicate EAN text
  dup_ean_text <- df %>%
    group_by(POS_Barcode_No) %>%
    summarise(n_text = n_distinct(Bezeichnung), .groups = "drop") %>%
    filter(n_text > 1) %>%
    nrow()
  
  # 2. EAN empty
  ean_empty <- sum(is.na(EAN) | trimws(EAN) == "" | EAN == "0")
  
  # 3. EAN non-numeric
  ean_non_numeric <- sum(!grepl("^[0-9]+$", EAN) & !is.na(EAN))
  
  # 4. length error
  ean_length_error <- sum(nchar(EAN) > 14, na.rm = TRUE)
  
  # 5. qty decimal
  qty_decimal <- sum(!is.na(Sales) & Sales %% 1 != 0)
  
  # 6. mix price
  mix_price_ean <- df %>% 
    filter(!is.na(calculate_price)) %>%
    group_by(POS_Barcode_No) %>%
    summarise(
      n_price = dplyr::n_distinct(calculate_price, na.rm = TRUE),
      .groups = "drop"
    ) %>%
    filter(n_price > 1)
  
  mix_price_ean_count <- mix_price_ean %>% # For Summary
    nrow()
  # #-----------------------------------------------------------------------------------------------------
  # mix_price_df <- df %>%
  #   filter(POS_Barcode_No %in% mix_price_ean$POS_Barcode_No) # For Extracting list of all mix price cases
  # 
  # # Store list outside
  # mix_price_cases_list[[i]] <- mix_price_df %>%
  #   mutate(file_name = meta_df$file_name[i])
  
  # 7. week check
  week_file <- meta_df$week[i]
  week_data <- df$week_data
  
  week_distinct_count <- dplyr::n_distinct(week_data)
  week_mismatch_count <- sum(week_data != week_file, na.rm = TRUE)
  week_match_flag <- week_mismatch_count == 0 & week_distinct_count == 1
  
  # --- Output ---
  data.frame(
    
    file_name = meta_df$file_name[i],
    file_date = meta_df$file_date[i],
    file_day = meta_df$day[i],
    year_file = meta_df$year[i],
    week_file = week_file,
    # week_data = week_data,
    start_day = meta_df$start_week[i],
    end_day = meta_df$end_week[i],
    
    size_kb = meta_df$size_kb[i],
    
    records = nrow(df),
    n_ean   = dplyr::n_distinct(EAN),
    n_store = dplyr::n_distinct(df$POS_Store),
    
    total_sales   = sum(Sales, na.rm = TRUE),
    total_revenue = sum(Revenue, na.rm = TRUE),
    
    dup_ean_multi_text = dup_ean_text,
    ean_empty_count    = ean_empty,
    ean_non_numeric    = ean_non_numeric,
    ean_length_error   = ean_length_error,
    mix_price_ean_count = mix_price_ean_count,
    qty_decimal_count  = qty_decimal,
    week_distinct_count = week_distinct_count,
    week_mismatch_count = week_mismatch_count,
    week_match_flag     = week_match_flag
  )
  
  
}) %>% dplyr::bind_rows()

