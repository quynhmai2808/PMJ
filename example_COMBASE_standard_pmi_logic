data_list <- lapply(seq_len(nrow(meta_df)), function(i) {
  
  df <- read.csv(meta_df$files[i], sep = ";", fill = TRUE, quote = "")
  
  df %>%
    mutate(
      file_name  = meta_df$file_name[i],
      file_date  = as.character(meta_df$file_date[i]),
      year_file  = as.character(meta_df$year[i]),
      week_file  = as.character(meta_df$week[i]),
      day        = as.character(meta_df$day[i]),
